{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notification-hub-vnext.local/schemas/protocol-message.schema.json",
  "title": "Notification Hub vNext protocol message",
  "description": "Transport-independent JSON envelope. Named Pipe framing is defined separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "traceId",
    "type",
    "timestamp",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "hello",
        "health",
        "capabilities",
        "scene.create",
        "scene.update",
        "scene.dismiss",
        "scene.drag",
        "scene.set-mode",
        "config.update",
        "diagnostic.subscribe",
        "shutdown",
        "ack",
        "error"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
