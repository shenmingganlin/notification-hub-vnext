{
  "manifestVersion": 1,
  "id": "notification-hub-vnext",
  "name": "Notification Hub vNext",
  "version": "0.1.8",
  "description": "Notification Hub vNext for HanaAgent.",
  "minAppVersion": "0.158.0",
  "trust": "full-access",
  "activationEvents": [
    "onStartup"
  ],
  "ui": {
    "hostCapabilities": ["resource.pick"]
  },
  "capabilities": ["resource.materialize", "resource.write"],
  "contributes": {
    "page": {
      "title": {
        "zh": "Notification Center",
        "en": "Notification Center"
      },
      "route": "/notification-center",
      "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9\"/><path d=\"M10 21h4\"/></svg>"
    },
    "widget": {
      "title": "Notification Hub",
      "route": "/widget"
    },
    "tools": [
      "./tools/notification-hub-run-test.js"
    ],
    "routes": ["./routes/widget.js", "./routes/settings.js", "./routes/settings-sound.js", "./routes/settings-visual.js", "./routes/settings-visual-assets.js", "./routes/settings-visual-assets-page.js", "./routes/settings-font-assets.js", "./routes/settings-font-assets-page.js", "./routes/notification-center.js", "./routes/runtime.js", "./routes/diagnostics.js"],
    "configuration": {
      "properties": {
        "settingsHint": {
          "type": "string",
          "title": "详细设置请到页面配置",
          "description": "声音、视觉、通知中心都在插件页面里改。宿主开关收尾时再加回来。",
          "default": "详细设置请到页面配置",
          "enum": ["详细设置请到页面配置"]
        }
      }
    }
  },
  "dev": {
    "scenarios": [
      {
        "id": "open-notification-center",
        "title": "Open Notification Center",
        "steps": [{ "openSurface": "/notification-center" }]
      }
    ]
  }
}
